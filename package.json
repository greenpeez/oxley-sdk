{
  "name": "@oxley/sdk",
  "version": "0.7.0-next.0",
  "description": "Oxley Gen10 auctions on Elysium: market data, quotes, swaps (with optional integrator fees), terms, Dynamic Bids and rebids, and claim and refund transactions, as unsigned calldata for apps, bots and AI agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenpeez/oxley-sdk.git"
  },
  "homepage": "https://github.com/greenpeez/oxley-sdk#readme",
  "bugs": {
    "url": "https://github.com/greenpeez/oxley-sdk/issues"
  },
  "keywords": ["oxley", "elysium", "usdc", "auctions", "dynamic-bids", "ai-agents", "dex", "aggregator", "0x"],
  "packageManager": "pnpm@10.32.1",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./abis": {
      "types": "./dist/abis.d.ts",
      "import": "./dist/abis.js"
    },
    "./0x": {
      "types": "./dist/zero-ex.d.ts",
      "import": "./dist/zero-ex.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./auctions": {
      "types": "./dist/auctions.d.ts",
      "import": "./dist/auctions.js"
    },
    "./launch": {
      "types": "./dist/launch.d.ts",
      "import": "./dist/launch.js"
    },
    "./abis/curve.json": "./abis/curve.json",
    "./abis/bid-router.json": "./abis/bid-router.json",
    "./abis/bid-hook.json": "./abis/bid-hook.json",
    "./abis/terms-registry.json": "./abis/terms-registry.json",
    "./abis/cca-auction.json": "./abis/cca-auction.json",
    "./deployments/elysium-testnet.json": "./deployments/elysium-testnet.json",
    "./deployments/mainnet.template.json": "./deployments/mainnet.template.json"
  },
  "files": [
    "dist",
    "abis",
    "deployments",
    "docs",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:evm": "node --import tsx --test test/integration/*.test.ts",
    "test:package": "node scripts/check-package.mjs",
    "bundle": "node scripts/bundle.mjs",
    "test:live": "node --import tsx scripts/check-testnet.ts",
    "test:live:auctions": "node --import tsx scripts/check-auctions-testnet.ts",
    "test:live:launch": "node --import tsx scripts/check-launch-testnet.ts",
    "test:live:markets": "node --import tsx scripts/check-markets-testnet.ts",
    "embed": "node scripts/embed-deployments.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "viem": "2.55.5"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
